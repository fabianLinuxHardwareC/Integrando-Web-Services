<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraNavegador"
        android:layout_width="0dp"
        android:layout_height="56dp"

        android:background="@color/azul"
        app:title="@string/app_name"
        app:titleTextColor="@color/blanco"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/textoBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/mensaje_bienvenida"
        android:textSize="@dimen/tam_titulos"
        android:textColor="@color/negro"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/barraNavegador"
        app:layout_constraintBottom_toTopOf="@id/imagenMascota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
        android:id="@+id/imagenMascota"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_mascota"
        android:contentDescription="@string/descripcion_logo"
        app:tint="@color/azul"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textoBienvenida"
        app:layout_constraintBottom_toTopOf="@id/botonIniciar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonIniciar"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="@string/texto_iniciar"
        android:textSize="@dimen/tam_letras"
        android:textColor="@color/blanco"
        app:backgroundTint="@color/gris"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/imagenMascota"
        app:layout_constraintBottom_toTopOf="@id/botonCreditos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCreditos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/texto_creditos"
        android:textSize="@dimen/tam_letras"
        android:textColor="@color/blanco"
        app:backgroundTint="@color/gris"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>